<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MyReviewsActivity">

    <LinearLayout style="@style/AppToolbar">
        <ImageButton
            android:id="@+id/tvBackReviews"
            style="@style/AppToolbarBackButton" />

        <TextView
            style="@style/AppToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Đánh giá của tôi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvTabPending"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="Chưa đánh giá"
            android:textSize="13sp"
            tools:background="@drawable/bg_chip_blue"
            tools:textColor="@color/primary"
            tools:textStyle="bold" />

        <TextView
            android:id="@+id/tvTabDone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="Đã đánh giá"
            android:textSize="13sp"
            tools:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvReviews"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            tools:itemCount="1"
            tools:listitem="@layout/item_review_row"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvReviewsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary"
            android:drawableTop="@drawable/ic_star"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Bạn chưa gửi đánh giá nào"
            tools:visibility="gone" />
    </FrameLayout>
</LinearLayout>
