<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    tools:context=".CheckoutActivity">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_chip_blue">

        <ImageView
            android:id="@+id/ivCheckoutImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@color/white"
            android:contentDescription="Ảnh sản phẩm"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_product_image_placeholder"
            tools:src="@drawable/ic_product_image_placeholder" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCheckoutName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Tai nghe Sony WH-1000XM5" />

        <TextView
            android:id="@+id/tvCheckoutQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_counter_btn"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="8.490.000 ₫  ×1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCheckoutSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="8.490.000 ₫" />
</LinearLayout>
