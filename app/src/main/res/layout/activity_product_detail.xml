<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".ProductDetailActivity">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppToolbar"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/AppToolbarBackButton" />

        <TextView
            style="@style/AppToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Chi tiết sản phẩm" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHeaderCart"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Giỏ hàng"
                    android:src="@drawable/ic_cart"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvHeaderCartCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_primary_button"
                    android:gravity="center"
                    android:minWidth="17dp"
                    android:paddingHorizontal="4dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="3" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Thêm vào giỏ"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_cart"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyNow"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Mua ngay"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/white" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollProductDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionBar"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh sản phẩm"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_product_image_placeholder"
                    tools:src="@drawable/ic_product_image_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="iPhone 15 128GB" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#EF4444"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="22.990.000 ₫" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAvgStar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 5,0"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="★ 5,0" />

                    <TextView
                        android:id="@+id/tvProductReviewSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="(1 đánh giá) · Đã bán 18" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Điện thoại" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0D9488"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Còn 25 sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mô tả sản phẩm"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/primary" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="iPhone 15 với chip A16 Bionic, màn hình OLED 6.1 inch và camera 48MP." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đánh giá của người mua"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutRatingOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rating_overview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRatingScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="5.0" />

                        <TextView
                            android:id="@+id/tvRatingStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFF59E0B"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="★★★★★" />

                        <TextView
                            android:id="@+id/tvRatingTotalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            tools:text="1 đánh giá" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="80dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:text="5 ★"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <ProgressBar
                                android:id="@+id/progressStar5"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/bg_rating_progress_bar"
                                tools:progress="100" />
                            <TextView
                                android:id="@+id/tvCountStar5"
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:text="4 ★"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <ProgressBar
                                android:id="@+id/progressStar4"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/bg_rating_progress_bar"
                                tools:progress="0" />
                            <TextView
                                android:id="@+id/tvCountStar4"
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="0" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:text="3 ★"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <ProgressBar
                                android:id="@+id/progressStar3"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/bg_rating_progress_bar"
                                tools:progress="0" />
                            <TextView
                                android:id="@+id/tvCountStar3"
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="0" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:text="2 ★"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <ProgressBar
                                android:id="@+id/progressStar2"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/bg_rating_progress_bar"
                                tools:progress="0" />
                            <TextView
                                android:id="@+id/tvCountStar2"
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="0" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:text="1 ★"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <ProgressBar
                                android:id="@+id/progressStar1"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/bg_rating_progress_bar"
                                tools:progress="0" />
                            <TextView
                                android:id="@+id/tvCountStar1"
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="0" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_review_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Tất cả"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFilter5Star"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_review_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="5 sao"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnFilter4Star"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_review_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="4 sao"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnFilter3Star"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_review_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="3 sao"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnFilter2Star"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_review_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="2 sao"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnFilter1Star"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_review_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="1 sao"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvProductReviewListEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_review_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="16dp"
                    android:text="Chưa có đánh giá nào cho sản phẩm này."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutProductReviewItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <include
                        layout="@layout/item_review_preview"
                        tools:visibility="visible" />

                    <include
                        layout="@layout/item_review_preview"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
