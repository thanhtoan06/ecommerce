<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppToolbar">

        <ImageButton
            android:id="@+id/btnBackToHome"
            style="@style/AppToolbarBackButton" />

        <TextView
            style="@style/AppToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Đăng ký tài khoản" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tạo tài khoản mới"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivRegisterAvatar"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                android:contentDescription="Ảnh đại diện (không bắt buộc)"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_default" />

            <ImageButton
                android:id="@+id/btnChooseAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_edit_avatar_button"
                android:contentDescription="Thêm hoặc thay đổi ảnh đại diện"
                android:elevation="3dp"
                android:padding="7dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HỌ VÀ TÊN" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtFullName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_person" android:drawablePadding="10dp" android:hint="Nhập họ và tên của bạn" android:imeOptions="actionNext" android:inputType="textPersonName" android:maxLines="1" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TÊN ĐĂNG NHẬP" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtRegisterUsername" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_person" android:drawablePadding="10dp" android:hint="Nhập tên đăng nhập" android:imeOptions="actionNext" android:inputType="text" android:maxLines="1" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐỊA CHỈ EMAIL" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtRegisterEmail" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_email" android:drawablePadding="10dp" android:hint="Nhập email của bạn" android:imeOptions="actionNext" android:inputType="textEmailAddress" android:maxLines="1" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SỐ ĐIỆN THOẠI" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtRegisterPhone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_phone" android:drawablePadding="10dp" android:hint="Nhập số điện thoại của bạn" android:imeOptions="actionNext" android:inputType="phone" android:maxLines="1" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MẬT KHẨU (TỐI THIỂU 6 KÝ TỰ)" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="12dp">
                <EditText android:id="@+id/edtRegisterPassword" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_lock" android:drawablePadding="10dp" android:hint="Nhập mật khẩu an toàn" android:imeOptions="actionNext" android:inputType="textPassword" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="46dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />
                <ImageView android:id="@+id/btnToggleRegisterPassword" android:layout_width="44dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Ẩn hiện mật khẩu đăng ký" android:focusable="true" android:padding="12dp" android:src="@drawable/ic_visibility_off" app:tint="@color/text_secondary" />
            </RelativeLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XÁC NHẬN MẬT KHẨU" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="20dp">
                <EditText android:id="@+id/edtConfirmPassword" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:drawableStart="@drawable/ic_lock" android:drawablePadding="10dp" android:hint="Nhập lại mật khẩu ở trên" android:imeOptions="actionDone" android:inputType="textPassword" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="46dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="14sp" />
                <ImageView android:id="@+id/btnToggleConfirmPassword" android:layout_width="44dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Ẩn hiện mật khẩu xác nhận" android:focusable="true" android:padding="12dp" android:src="@drawable/ic_visibility_off" app:tint="@color/text_secondary" />
            </RelativeLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                <Button android:id="@+id/btnSubmitRegister" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_primary_button" android:text="HOÀN TẤT ĐĂNG KÝ" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                <ProgressBar android:id="@+id/progressBarRegister" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateTint="@color/white" android:visibility="gone" />
            </FrameLayout>

            <Button android:id="@+id/btnBackToLogin" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary_button" android:text="ĐĂNG NHẬP NGAY" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
