<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".OrderHistoryActivity">

    <LinearLayout style="@style/AppToolbar">
        <ImageButton
            android:id="@+id/tvBackHistory"
            style="@style/AppToolbarBackButton" />

        <TextView
            style="@style/AppToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Lịch sử đơn hàng" />
        <TextView
            android:id="@+id/tvHistoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/order_history_count_preview"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="8 đơn" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp"
        android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvFilterAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="Tất cả"
                android:textSize="11sp"
                tools:background="@drawable/bg_chip_blue"
                tools:textColor="@color/primary"
                tools:textStyle="bold" />

            <TextView
                android:id="@+id/tvFilterDelivering"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="Đang giao"
                android:textSize="11sp"
                tools:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvFilterReceived"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="Đã nhận hàng"
                android:textSize="11sp"
                tools:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvFilterCancelled"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="Đã hủy"
                android:textSize="11sp"
                tools:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvOrderHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            tools:itemCount="1"
            tools:listitem="@layout/item_order"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary"
            android:drawableTop="@drawable/ic_orders"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="Không có đơn hàng nào"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="gone" />
    </FrameLayout>
</LinearLayout>
