<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp"
    tools:context=".OrderDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_chip_blue">

            <ImageView
                android:id="@+id/ivOrderDetailProduct"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:contentDescription="@string/product_image_description"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_product_image_placeholder"
                tools:src="@drawable/ic_product_image_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderDetailProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Tai nghe Sony WH-1000XM5" />

            <TextView
                android:id="@+id/tvOrderDetailProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Đơn giá: 8.490.000 ₫ · Số lượng: x1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderDetailProductSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="8.490.000 ₫" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOrderDetailViewProduct"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/order_view_product"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="12sp"
        app:backgroundTint="@color/white"
        app:cornerRadius="9dp"
        app:strokeColor="@color/card_stroke" />
</LinearLayout>
