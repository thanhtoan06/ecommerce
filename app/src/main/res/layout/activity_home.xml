<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/layoutUserInfo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivHeaderAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_default" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvUserGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" tools:text="Xin chào, UserDemo" />
                    <TextView android:id="@+id/tvUserEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#DCE6FF" android:textSize="12sp" tools:text="demo@shop.vn" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutGuestActions"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chào mừng bạn!" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khám phá cửa hàng" android:textColor="#DCE6FF" android:textSize="12sp" />
                </LinearLayout>
                <Button android:id="@+id/btnHomeLogin" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_search_white" android:text="Đăng nhập" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" app:backgroundTint="@null" />
                <Button android:id="@+id/btnHomeRegister" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_search_white" android:text="Đăng ký" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" app:backgroundTint="@null" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_white"
                android:elevation="2dp">
                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:autofillHints="search"
                    android:hint="@string/home_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="38dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />
                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:clickable="true"
                    android:contentDescription="@string/home_clear_search"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_tertiary" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <RelativeLayout
                    android:id="@+id/btnCategory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp">
                    <TextView
                        android:id="@+id/tvCategoryLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/ivCategoryArrow"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_category_default_label"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/ivCategoryArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/primary" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/btnSort"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp">
                    <ImageView
                        android:id="@+id/ivSortIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/primary" />
                    <TextView
                        android:id="@+id/tvSortLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="6dp"
                        android:layout_toEndOf="@id/ivSortIcon"
                        android:layout_toStartOf="@id/ivSortArrow"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_sort_label"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/ivSortArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/primary" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <GridView
                android:id="@+id/gridProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:horizontalSpacing="12dp"
                android:numColumns="2"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="12dp"
                tools:itemCount="10"
                tools:listitem="@layout/item_product" />
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_product_image_placeholder" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Không tìm thấy sản phẩm nào" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <Button android:id="@+id/btnResetFilter" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="16dp" android:background="@drawable/bg_primary_button" android:text="Xem tất cả" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" app:backgroundTint="@null" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/include_bottom_navigation" />
</LinearLayout>
